<Window x:Class="Zad2_Shop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин" Height="500" Width="650">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <Menu Grid.Row="0" Margin="0,0,0,10">
            <MenuItem Header="Действия">
                <MenuItem Header="Добавить товар" Click="MenuAdd_Click"/>
                <MenuItem Header="Продать товар" Click="MenuSell_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Отчеты">
                <MenuItem Header="Показать все товары" Click="MenuShowAll_Click"/>
                <MenuItem Header="Финансовый отчет" Click="MenuReport_Click"/>
            </MenuItem>
        </Menu>

        
        <GroupBox Header="Добавить товар" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Название:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtName" Width="200" Tag="Название"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цена:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPrice" Width="200" Tag="Цена"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Количество:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtCount" Width="200" Tag="Количество"/>
                </StackPanel>
                <Button x:Name="btnAdd" Content="Добавить" Click="BtnAdd_Click" 
                        Background="LightGreen" Width="100" Margin="70,10,0,0"/>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Header="Продать товар" Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Название:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSellName" Width="200" Tag="Название"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Количество:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSellCount" Width="200" Tag="Кол-во" Text="1"/>
                </StackPanel>
                <Button x:Name="btnSell" Content="Продать" Click="BtnSell_Click" 
                        Background="LightCoral" Width="100" Margin="70,10,0,0"/>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Header="Товары в наличии" Grid.Row="3" Margin="0,0,0,10">
            <ListBox x:Name="lbProducts" Height="180"/>
        </GroupBox>

        
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="tbProfit" FontWeight="Bold" Foreground="Green"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>