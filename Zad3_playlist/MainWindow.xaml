<Window x:Class="Zad3_playlist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Плейлист" Height="600" Width="450">
    <StackPanel Margin="10">
        <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Добавить песню" FontWeight="Bold" Margin="0,0,0,5"/>


                <StackPanel Margin="0,5">
                    <TextBlock Text="Автор:" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtAuthor" ToolTip="Введите автора"/>
                </StackPanel>


                <StackPanel Margin="0,5">
                    <TextBlock Text="Название:" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtTitle" ToolTip="Введите название"/>
                </StackPanel>

                <Button x:Name="btnAdd" Content="Добавить" Background="Green" 
                        Foreground="White" FontWeight="Bold" Click="BtnAdd_Click"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Список песен" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox x:Name="lstSongs" Height="120" Margin="0,5" 
                         SelectionChanged="Vibor"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Сейчас играет" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="txtCurrentSong" Margin="0,5" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="btnPred" Content="Предыдущая" Width="100" Margin="2" 
                            Background="DodgerBlue" Foreground="White" FontWeight="Bold"
                            Click="BtnPred_Click"/>
                    <Button x:Name="btnSled" Content="Следующая" Width="100" Margin="2" 
                            Background="DodgerBlue" Foreground="White" FontWeight="Bold"
                            Click="BtnSled_Click"/>
                    <Button x:Name="btnVNachalo" Content="В начало" Width="100" Margin="2" 
                            Background="DodgerBlue" Foreground="White" FontWeight="Bold"
                            Click="BtnVNachalo_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,5,0,0">
                    <Button x:Name="btnDelete" Content="Удалить" Width="100" Margin="2" 
                            Background="Red" Foreground="White" FontWeight="Bold"
                            Click="BtnDelete_Click"/>
                    <Button x:Name="btnClear" Content="Очистить" Width="100" Margin="2" 
                            Background="DarkRed" Foreground="White" FontWeight="Bold"
                            Click="BtnClear_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="txtInfo" FontSize="11" Margin="0,10,0,0"/>
    </StackPanel>
</Window>